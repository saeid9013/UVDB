BOT_TOKEN=
BOT_POLLING_ENABLED=true
DATABASE_URL=postgresql+asyncpg://postgres:password@postgres:5432/railway
REDIS_URL=redis://redis:6379/0
SECRET_KEY=replace-with-a-long-random-value
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
APP_ENV=production
LOG_LEVEL=INFO
MAX_FILE_SIZE=524288000
MAX_VIDEO_DURATION=3600
MAX_CONCURRENT_DOWNLOADS=1
DOWNLOAD_TIMEOUT=300
RETRY_COUNT=2
TEMP_RETENTION_MINUTES=30
DAILY_DOWNLOAD_LIMIT=5
ACTIVE_REQUEST_LIMIT=2
